{
  // Only these Host headers are accepted (DNS-rebinding protection); ports are not part of the match.
  "AllowedHosts": "127.0.0.1;localhost;[::1]",
  "Web": {
    "Port": 47440,
    "LaunchTokenLifetimeSeconds": 120,
    "SessionIdleHours": 12,
    "AllowedDevOrigins": [],
    "OpenBrowserOnStart": false
  },
  // Where newer versions are announced: asked once a day while Settings > Privacy > Check for new versions is on.
  "Updates": {
    "Releases": "https://api.github.com/repos/ameralqarallih-lgtm/PC-Diagnostic/releases/latest"
  }
}
