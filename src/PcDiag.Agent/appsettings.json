{
  // Shipped defaults. User overrides go in %LOCALAPPDATA%\PcDiagnostic\settings.json (same structure).
  "Storage": {
    "DataDirectory": null,
    "TelemetryRetentionHours": 24,
    "RollupRetentionDays": 30,
    "WriteBehindSeconds": 5,
    "MaxIncidents": 0,
    "DataLimitGb": 10,
    "KeepFreeGb": 5
  },
  "Recorder": {
    "Mode": "Manual",
    "Schedule": [
      // Example: { "Days": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" ], "Start": "09:00", "End": "18:00" }
    ],
    "StartAgentAtLogon": false,
    "PreIncidentMinutes": 10,
    "PostIncidentSeconds": 120,
    "RingBufferMaxMegabytes": 64
  },
  "Sampling": {
    "SystemIntervalMs": 1000,
    "SensorIntervalMs": 1000,
    "ProcessIntervalMs": 2000,
    "InventoryIntervalSeconds": 10,
    "TopProcessCount": 25,
    "CpuBudgetPercent": 2.0
  },
  "Agent": {
    "ShowTrayIcon": true,
    // Global hotkey that captures an incident (works in full-screen games). Empty disables it.
    "CaptureHotkey": "Ctrl+Alt+Shift+I",
    "NotifyOnCapture": true
  },
  "Events": {
    // Classification rules: see event-rules.json; put overrides in %LOCALAPPDATA%\PcDiagnostic\event-rules.json.
    "BackfillMinutes": 30,
    "BootBackfillMaxHours": 24,
    "MaxPerRulePerMinute": 20,
    "MaxMessageLength": 2000
  },
  "Privacy": {
    "CaptureCommandLines": false,
    "CaptureUserNames": false,
    "CaptureWifiNetworkNames": false,
    "CollectWindowsEvents": true,
    "CollectNetworkDetails": true
  }
}
