    <TargetFramework>$(PcDiagTfm)</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PcDiag.Core\PcDiag.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Events\event-rules.json" LogicalName="PcDiag.Engine.Events.event-rules.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PcDiag.Engine.Tests" />
  </ItemGroup>
</Project>
