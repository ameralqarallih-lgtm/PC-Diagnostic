{
  "$comment": "Shipped anomaly rules (ARCHITECTURE §10). Users change them in Settings > Triggers; their changes are stored as overrides in settings.json (\"Triggers\"), never in this file. Rules that watch normal heavy use (full CPU or GPU load) record anomalies but do not create incidents unless the user turns that on.",
  "rules": [
    {
      "id": "cpu-high",
      "name": "High CPU load",
      "classification": "CPU saturation",
      "kind": "ThresholdDuration",
      "metric": "cpu",
      "direction": "Above",
      "threshold": 95,
      "durationSeconds": 30,
      "severity": "Medium",
      "createIncident": false,
      "note": "Recorded as an anomaly; no incident by default, because full CPU load is normal while compiling, rendering or gaming."
    },
    {
      "id": "cpu-baseline",
      "name": "Unusual CPU load",
      "classification": "CPU utilization anomaly",
      "kind": "BaselineDeviation",
      "metric": "cpu",
      "direction": "Above",
      "threshold": 3,
      "durationSeconds": 15,
      "baselineMinutes": 30,
      "warmupMinutes": 5,
      "minStdDev": 5,
      "severity": "Low",
      "createIncident": false
    },
    {
      "id": "memory-low",
      "name": "Low available memory",
      "classification": "Memory pressure",
      "kind": "ThresholdDuration",
      "metric": "memory.available",
      "direction": "Below",
      "threshold": 1,
      "durationSeconds": 5,
      "severity": "High",
      "createIncident": true
    },
    {
      "id": "memory-commit-high",
      "name": "Memory commit near its limit",
      "classification": "Memory pressure",
      "kind": "ThresholdDuration",
      "metric": "memory.commit",
      "direction": "Above",
      "threshold": 95,
      "durationSeconds": 10,
      "severity": "High",
      "createIncident": false,
      "note": "When commit reaches its limit Windows logs a low-virtual-memory event, which the \"Windows resource exhaustion\" trigger watches."
    },
    {
      "id": "gpu-high",
      "name": "High GPU load",
      "classification": "GPU saturation",
      "kind": "ThresholdDuration",
      "metric": "gpu.util",
      "direction": "Above",
      "threshold": 98,
      "durationSeconds": 20,
      "severity": "Low",
      "createIncident": false,
      "note": "Recorded as an anomaly; no incident by default, because a game or render keeps the GPU at full load."
    },
    {
      "id": "gpu-baseline",
      "name": "Unusual GPU load",
      "classification": "GPU utilization anomaly",
      "kind": "BaselineDeviation",
      "metric": "gpu.util",
      "direction": "Above",
      "threshold": 3,
      "durationSeconds": 15,
      "baselineMinutes": 30,
      "warmupMinutes": 5,
      "minStdDev": 5,
      "severity": "Low",
      "createIncident": false
    },
    {
      "id": "gpu-clock-drop",
      "name": "Sudden GPU clock drop",
      "classification": "GPU clock drop under load",
      "kind": "RateOfChange",
      "metric": "gpu.core",
      "direction": "Below",
      "threshold": 60,
      "windowSeconds": 2,
      "guardMetric": "gpu.util",
      "guardMinimum": 30,
      "severity": "Medium",
      "createIncident": true,
      "note": "Only while the GPU stays busy, so clocks falling with the load (a game menu, an idle desktop) do not count."
    },
    {
      "id": "gpu-temp-high",
      "name": "High GPU temperature",
      "classification": "GPU temperature anomaly",
      "kind": "ThresholdDuration",
      "metric": "gpu.temp",
      "direction": "Above",
      "threshold": 87,
      "durationSeconds": 10,
      "severity": "High",
      "createIncident": true
    },
    {
      "id": "gpu-hotspot-high",
      "name": "High GPU hotspot temperature",
      "classification": "GPU temperature anomaly",
      "kind": "ThresholdDuration",
      "metric": "gpu.hotspot",
      "direction": "Above",
      "threshold": 105,
      "durationSeconds": 10,
      "severity": "High",
      "createIncident": true
    },
    {
      "id": "gpu-vram-full",
      "name": "GPU memory full",
      "classification": "VRAM pressure",
      "kind": "ThresholdDuration",
      "metric": "gpu.vram",
      "direction": "Above",
      "threshold": 97,
      "durationSeconds": 10,
      "severity": "Medium",
      "createIncident": false
    },
    {
      "id": "gpu-vram-high-sustained",
      "name": "GPU memory nearly full for minutes",
      "classification": "VRAM pressure",
      "kind": "ThresholdDuration",
      "metric": "gpu.vram",
      "direction": "Above",
      "threshold": 90,
      "durationSeconds": 300,
      "severity": "Medium",
      "createIncident": true
    },
    {
      "id": "cpu-temp-high",
      "name": "High CPU temperature",
      "classification": "CPU temperature anomaly",
      "kind": "ThresholdDuration",
      "metric": "cpu.temp",
      "direction": "Above",
      "threshold": 95,
      "durationSeconds": 30,
      "severity": "Medium",
      "createIncident": false,
      "note": "No incident by default: many current CPUs run at 95 °C or more under full load by design. Set the threshold for your CPU."
    },
    {
      "id": "disk-latency-high",
      "name": "Slow disk responses",
      "classification": "Disk latency anomaly",
      "kind": "ThresholdDuration",
      "metric": "disk.latency",
      "direction": "Above",
      "threshold": 200,
      "durationSeconds": 5,
      "severity": "Medium",
      "createIncident": false,
      "note": "A hard disk under heavy load can be this slow; on an SSD it usually means a problem."
    },
    {
      "id": "disk-queue-high",
      "name": "Long disk queue",
      "classification": "Disk queue anomaly",
      "kind": "ThresholdDuration",
      "metric": "disk.queue",
      "direction": "Above",
      "threshold": 10,
      "durationSeconds": 10,
      "severity": "Low",
      "createIncident": false
    },
    {
      "id": "network-errors",
      "name": "Network packet errors",
      "classification": "Network error spike",
      "kind": "CounterSpike",
      "metric": "net.errors",
      "direction": "Above",
      "threshold": 50,
      "windowSeconds": 10,
      "severity": "Medium",
      "createIncident": true,
      "note": "Counts receive and send errors only; discarded packets are normal on many networks."
    },
    {
      "id": "game-fps-drop",
      "name": "Game frame rate drop",
      "classification": "Frame rate drop",
      "kind": "ThresholdDuration",
      "metric": "game.drop",
      "direction": "Above",
      "threshold": 40,
      "durationSeconds": 5,
      "severity": "Medium",
      "createIncident": true,
      "note": "The game in front (full screen or a borderless window) ran 40 % or more below its usual frame rate (the median of its last two minutes) for 5 s; the incident's findings say what else changed while it did."
    },
    {
      "id": "game-stutter",
      "name": "Game stutters",
      "classification": "Frame pacing",
      "kind": "CounterSpike",
      "metric": "game.stutters",
      "direction": "Above",
      "threshold": 5,
      "windowSeconds": 10,
      "severity": "Medium",
      "createIncident": true,
      "note": "Five or more frames within 10 s that each took at least 2.5 times as long as the frames around them (and 20 ms longer): hitches, not a slow stretch, which the frame rate drop rule watches."
    },
    {
      "id": "driver-time-high",
      "name": "Drivers holding a processor",
      "classification": "Driver latency",
      "kind": "ThresholdDuration",
      "metric": "latency.dpc",
      "direction": "Above",
      "threshold": 40,
      "durationSeconds": 5,
      "severity": "Medium",
      "createIncident": false,
      "note": "One processor spent 40 % of its time or more in drivers' DPCs or interrupts for 5 s (a game at a high frame rate keeps one at 20-25 %, which is normal); a driver latency measurement starts by itself and names the driver."
    },
    {
      "id": "driver-slow",
      "name": "Slow driver routine",
      "classification": "Driver latency",
      "kind": "Threshold",
      "metric": "latency.driver",
      "direction": "Above",
      "threshold": 2000,
      "severity": "Medium",
      "createIncident": false,
      "note": "A driver latency measurement found a driver's DPC or ISR running 2 ms or more at once (sound drops out, frames and input come late)."
    },
    {
      "id": "connection-loss",
      "name": "Lost packets",
      "classification": "Connection problem",
      "kind": "ThresholdDuration",
      "metric": "conn.loss",
      "direction": "Above",
      "threshold": 10,
      "durationSeconds": 20,
      "severity": "Medium",
      "createIncident": true,
      "note": "More than 2 of the last 20 pings to the internet were lost for 20 s; the incident shows whether the router and the provider's first hop lost them too."
    },
    {
      "id": "home-network-slow",
      "name": "Slow home network",
      "classification": "Connection problem",
      "kind": "ThresholdDuration",
      "metric": "conn.router",
      "direction": "Above",
      "threshold": 50,
      "durationSeconds": 10,
      "severity": "Low",
      "createIncident": false,
      "note": "The router took 50 ms or more to answer for 10 s (it usually answers in a few ms): Wi-Fi interference or a busy router."
    },
    {
      "id": "internet-ping-rising",
      "name": "Internet round trips rising",
      "classification": "Connection problem",
      "kind": "BaselineDeviation",
      "metric": "conn.ping",
      "direction": "Above",
      "threshold": 4,
      "durationSeconds": 10,
      "baselineMinutes": 30,
      "warmupMinutes": 5,
      "minStdDev": 10,
      "severity": "Low",
      "createIncident": false
    },
    {
      "id": "dns-failing",
      "name": "DNS lookups failing",
      "classification": "Connection problem",
      "kind": "CounterSpike",
      "metric": "conn.dns_failed",
      "direction": "Above",
      "threshold": 2,
      "windowSeconds": 60,
      "severity": "Low",
      "createIncident": false,
      "note": "Two failed DNS lookups within a minute (one is timed every 10 s)."
    },
    {
      "id": "gpu-reset",
      "name": "GPU reset (TDR)",
      "classification": "GPU reset",
      "kind": "Event",
      "eventRules": [ "gpu.tdr", "wer.live-kernel.video-*" ],
      "description": "Windows logs that the display driver stopped responding and was reset",
      "severity": "High",
      "createIncident": true
    },
    {
      "id": "display-driver-error",
      "name": "Display driver error",
      "classification": "Display driver error",
      "kind": "Event",
      "eventRules": [ "gpu.nvidia.error", "gpu.amd.error", "gpu.intel.error", "gpu.dxgkrnl" ],
      "description": "Windows logs an error from the display driver or the graphics kernel",
      "severity": "High",
      "createIncident": true
    },
    {
      "id": "app-crash",
      "name": "Application crash",
      "classification": "Application crash",
      "kind": "Event",
      "eventRules": [ "app.crash", "app.dotnet-unhandled-exception" ],
      "processEvents": [ "Crashed" ],
      "description": "An application crashes (Windows Error Reporting or the process exits with a crash code)",
      "severity": "High",
      "createIncident": true
    },
    {
      "id": "app-hang",
      "name": "Application not responding",
      "classification": "Application hang",
      "kind": "Event",
      "eventRules": [ "app.hang" ],
      "processEvents": [ "Hung" ],
      "description": "An application window stays unresponsive for 30 seconds while the program draws nothing, or Windows closes a frozen window",
      "severity": "Medium",
      "createIncident": true
    },
    {
      "id": "display-change",
      "name": "Display configuration change",
      "classification": "Display configuration change",
      "kind": "Event",
      "displayChanges": [ "Connected", "Disconnected", "TopologyChanged", "ResolutionChanged", "RefreshRateChanged", "HdrChanged", "Reconfigured" ],
      "description": "A display connects or disconnects, or its resolution, refresh rate, HDR or layout changes",
      "severity": "Low",
      "createIncident": false,
      "note": "No incident by default, because changing display settings is usually intentional. Turn it on to catch displays that drop out on their own."
    },
    {
      "id": "hardware-error",
      "name": "Windows hardware error",
      "classification": "Hardware error",
      "kind": "Event",
      "eventRules": [ "hardware.whea.error", "hardware.whea.corrected" ],
      "description": "Windows Hardware Error Architecture (WHEA) reports a hardware error",
      "severity": "Critical",
      "createIncident": true
    },
    {
      "id": "storage-error",
      "name": "Storage error",
      "classification": "Storage error",
      "kind": "Event",
      "eventRules": [ "disk.error", "storage.controller.reset", "storage.controller.error", "filesystem.ntfs" ],
      "description": "Windows logs a disk, storage controller or file system error",
      "severity": "High",
      "createIncident": true
    },
    {
      "id": "resource-exhaustion",
      "name": "Windows resource exhaustion",
      "classification": "Resource exhaustion",
      "kind": "Event",
      "eventRules": [ "resource.low-virtual-memory" ],
      "description": "Windows logs that it is running out of virtual memory",
      "severity": "High",
      "createIncident": true
    }
  ]
}
