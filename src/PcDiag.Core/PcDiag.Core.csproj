<Project Sdk="Microsoft.NET.Sdk">
  <!-- Domain models, interfaces and options. No Windows or storage dependencies. -->
  <PropertyGroup>
    <TargetFramework>$(PcDiagTfm)</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Anomalies\anomaly-rules.json" LogicalName="PcDiag.Core.Anomalies.anomaly-rules.json" />
    <!-- The shipped characters and the reactions' effects (web/characters/bake-characters.mjs bakes them). -->
    <EmbeddedResource Include="Overlay\Characters\*.char" LogicalName="PcDiag.Core.Overlay.Characters.%(Filename).char" />
    <!-- The characters' reactions to readings: the editor's table, embedded for the recorder. -->
    <EmbeddedResource Include="..\..\web\src\features\overlay\characters\reactions.json" LogicalName="PcDiag.Core.Overlay.reactions.json" Link="Overlay\reactions.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PcDiag.Core.Tests" />
    <InternalsVisibleTo Include="PcDiag.Agent.Tests" />
  </ItemGroup>
</Project>
