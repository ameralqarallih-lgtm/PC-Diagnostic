<Project>
  <!-- Shared settings for every .NET project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <!-- CS1573: record parameters are documented only where the name is not self-explanatory. -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>

    <Company>PC Diagnostic</Company>
    <Product>PC Diagnostic &amp; Incident Recorder</Product>
    <Version>1.0.6</Version>

    <!-- Shared target frameworks. Windows-specific projects opt in to PcDiagWindowsTfm. -->
    <PcDiagTfm>net10.0</PcDiagTfm>
    <PcDiagWindowsTfm>net10.0-windows10.0.19041.0</PcDiagWindowsTfm>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.Contains('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1707: underscores in test names are idiomatic; CA2007: no ConfigureAwait in tests. -->
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>
</Project>


